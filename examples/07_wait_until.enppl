note [E++ 1.5a1: wait until — the new core statement.]
note [No library is needed: waiting is part of E++ itself.]
note [That goes for a plain wait too, so this file adds nothing at all.]

let 'Ready' be 0
say "Getting things ready..."

note [wait until holds the program until the condition is true.]
let 'Ready' be 1
wait until 'Ready' is 1
say "Ready! The wait finished as soon as the condition was true."

note [Give a wait a deadline so a mistake cannot hang the program:]
let 'Never' be 0
wait at most 1 second until 'Never' is 1
say "One second passed, so the deadline ended the wait quietly."

note [And a plain pause needs no library either — seconds or milliseconds:]
wait 250 milliseconds
wait 0.1 seconds
say "And a plain wait still works."
