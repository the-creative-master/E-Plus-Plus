note [E++ 1.3.5 Grand Showcase (.enppl)]
add the "Time" library
add the "Math" library
add the "Random" library
add the "Strings" library
add the "Files" library
add the "System" library
add the "Python" library

say "========================================================="
say "         Welcome to E++ 1.3.5!           "
say "========================================================="

note [System & Time Diagnostics]
say "System Platform:", the platform
say "Current Date & Time:", the current date, "at", the current time

note [Natural Math & Random Computations]
say "Square root of 144 is", the square root of 144
say "Rolling a 20-sided dice gives:", roll a dice with 20 sides
say "Flipping a coin gives:", flip a coin

note [Strings Processing]
let 'Announcement' be "   e++ is readable like english!   "
say "Trimmed:", the trim of 'Announcement'
say "Uppercase:", the uppercase of the trim of 'Announcement'

note [File Persistence]
write "E++ 1.3.5 verified on: " to file "showcase_audit.log"
append the current date to file "showcase_audit.log"
read the file "showcase_audit.log" and save the output as 'Audit'
say "Audit log content:", 'Audit'

note [Python Engine Bridge]
let 'EppVersion' be "1.3.5"
run the python code:
print(f"[Python Subsystem] Connected with E++ v{EppVersion}")
import math
print(f"[Python Subsystem] Computed 10! = {math.factorial(10)}")

say "✓ E++ 1.3.5 showcase complete!"
