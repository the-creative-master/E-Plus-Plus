    "build": "node tools/build-tutorial-pack.mjs && node tools/build-settings-schema.mjs",
    "test": "npm run build && node tests/run-tests.mjs",
    "test:ide": "node tests/ide-smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
