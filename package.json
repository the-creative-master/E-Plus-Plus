{
  "name": "e-plus-plus",
  "version": "6.1.1",
  "description": "E++ Dev Build 6.1.1 — a programming language that looks like English, reads like English, and behaves like code — plus its complete online IDE for .eppl and .eppla files.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "build:tutorial": "node tools/build-tutorial-pack.mjs",
